<!-- 
    refer to https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <TargetFramework>net7.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNet.WebApi.Client" Version="6.0.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components" Version="6.0.0.0" />
  </ItemGroup>
</Project>