<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:FooWpf.Model"
                    >

    <DataTemplate x:Key="ProductDataTemplate">
        <StackPanel>
            <TextBlock Text="{Binding Path=ProductName}" />
            <TextBlock Text="{Binding Path=Price}"/>
            <TextBlock Text="{Binding Path=Image}"/>
            <TextBlock Text="{Binding Path=ProductType}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="HProductName">
        <StackPanel>
            <TextBlock Text="{Binding DataContext.LabelStrings[ProductName], RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="CProductName">
        <StackPanel>
            <TextBlock Text="{Binding Path=ProductName}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="CProductPrice">
        <StackPanel>
            <TextBlock Text="{Binding Path=Price}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>