<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:FooWpf"
                    >

    <!--Bring in the data templates for use in here-->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Styles/DataTemplates.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--A Style that affects all TextBlocks-->
    <Style TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Comic Sans MS"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Background" Value="White"></Setter>
    </Style>
    
    <SolidColorBrush x:Key="brushBlue" Color="Blue"/>
    <SolidColorBrush x:Key="brushRed" Color="Red"/>

    <ControlTemplate x:Key="roundbutton" TargetType="Button">
        <Grid>
            <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding Foreground}" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </ControlTemplate>
    
    <ControlTemplate x:Key="anotherroundbutton" TargetType="Button">
        <Grid>
            <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding Foreground}" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Trigger.Setters>
                    <Setter Property="Background" Value="{StaticResource brushRed}"></Setter>
                </Trigger.Setters>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="resultsviewerblock" TargetType="{x:Type TextBlock}">
        <Setter Property="Background" Value="Yellow"></Setter>
        <Setter Property="Foreground" Value="{StaticResource brushBlue}"></Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="true" >
                <Setter Property="Background" Value="Green" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="resultsviewer" TargetType="Control">
        <Grid Background="Chocolate">
            <StackPanel Grid.Row="0">
                <ScrollViewer Width="500" Height="130" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Visible" VerticalContentAlignment="Stretch" Padding="5,5,5,5">
                <TextBlock Text="{Binding TextResult,Mode=OneWay}" Foreground="{StaticResource brushBlue}" Style="{StaticResource resultsviewerblock}" VerticalAlignment="Stretch"></TextBlock>
            </ScrollViewer>
            </StackPanel>
        </Grid>    
    </ControlTemplate>

    <ControlTemplate x:Key="resultslistbox" TargetType="Control">
        <Grid Background="Red">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" VerticalAlignment="Center">
                <ListBox MinWidth="500" Margin="5,5,5,5" MaxHeight="100" Padding="5,5,5,5"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         HorizontalContentAlignment="Stretch" 
                         VerticalContentAlignment="Stretch"
                         ItemsSource="{Binding Products,Mode=OneWay}" 
                         ItemTemplate="{StaticResource ProductDataTemplate}">
                </ListBox>
            </StackPanel>
        </Grid>
    </ControlTemplate>

</ResourceDictionary>