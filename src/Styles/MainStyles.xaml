<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--A Style that affects all TextBlocks-->
    <Style TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Comic Sans MS"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Background" Value="White"></Setter>
    </Style>
    
    <SolidColorBrush x:Key="brushBlue" Color="Blue"/>
    <SolidColorBrush x:Key="brushRed" Color="Red"/>

    <ControlTemplate x:Key="roundbutton" TargetType="Button">
        <Grid>
            <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding Foreground}" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </ControlTemplate>
    
    <ControlTemplate x:Key="anotherroundbutton" TargetType="Button">
        <Grid>
            <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding Foreground}" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Trigger.Setters>
                    <Setter Property="Background" Value="{StaticResource brushRed}"></Setter>
                </Trigger.Setters>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="resultsviewerblock" TargetType="{x:Type TextBlock}">
        <Setter Property="Background" Value="Yellow"></Setter>
        <Setter Property="Foreground" Value="{StaticResource brushBlue}"></Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="true" >
                <Setter Property="Background" Value="Green" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="resultsviewer" TargetType="Control">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <ScrollViewer Width="500" Height="130" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Visible">
                <TextBlock Text="{Binding TextResult,Mode=OneWay}" Foreground="{StaticResource brushBlue}" Style="{StaticResource resultsviewerblock}"></TextBlock>
            </ScrollViewer>
            </StackPanel>
            <StackPanel Grid.Row="1">
                <Button Template="{StaticResource anotherroundbutton}">Button 2</Button>
            </StackPanel>
        </Grid>    
    </ControlTemplate>

</ResourceDictionary>