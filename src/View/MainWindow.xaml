<Window x:Class="FooWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FooWpf.ViewModel" d:DataContext="{d:DesignInstance Type=local:ViewModelMain}"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="\Styles\MainStyles.xaml"/>
                <ResourceDictionary Source="\Styles\DataTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>



    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="22"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"></ColumnDefinition>
            <ColumnDefinition Width="auto"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0">
            <Button Command="{Binding UICommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type Window}}}"
                        Content="Button A">
            </Button>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1">
            <TextBox Width="500"  Height="25" Text="{Binding TextEntry,Mode=TwoWay}"></TextBox>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2">
            <Control Template="{StaticResource resultsviewer}"></Control>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Width="420" Height="170">
            <ListBox MinWidth="400" Width="400" MinHeight="160" Height="160" Margin="10" ItemsSource="{Binding Products,Mode=OneWay}" 
                     ItemTemplate="{StaticResource ProductDataTemplate}"/>
        </StackPanel>
    </Grid>
</Window>
